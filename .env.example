# Tradehelm secrets. Copy to .env (gitignored) and fill in. NEVER commit .env.
# All variables use the TRADEHELM_ prefix (see tradehelm/config/secrets.py).

# Saxo OpenAPI application credentials.
# Register a SIM app at https://www.developer.saxo/ (owner action item 1 in docs/PLAN.md).
# Use a local redirect URI, e.g. http://localhost:8765/callback
TRADEHELM_SAXO_APP_KEY=your-sim-app-key
TRADEHELM_SAXO_APP_SECRET=your-sim-app-secret

# Anthropic API key. Used ONLY by the advisor module (Phase 6). Leave blank until then.
TRADEHELM_ANTHROPIC_API_KEY=

# Single-user bearer token for the web API/UI (Phase 5). Leave blank until then.
TRADEHELM_API_TOKEN=
